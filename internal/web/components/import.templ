package components

import "agent-manager/internal/web/view"

// The registration modal (US1, T046, design lines 189-278).
//
// WHAT IT DOES NOT DO, and why: it does not submit. The web role's only door to
// data is internal/apiclient (principle II, and internal/archcheck enforces it),
// and the api's registration operations — POST /v1/packages/preview and
// POST /v1/packages — are reached through a client this role is not yet handed;
// wiring it is the US2 layer's job, along with the catalog itself. Everything the
// modal needs from the server is therefore a prop: Import.Preview is the api's
// PackagePreview, and until it arrives the panel is absent rather than blank.
//
// Every signal here is underscore-prefixed, which is what keeps the R7 budget
// intact: datastar excludes those from every request, so opening the modal,
// switching tabs and attaching a file cost zero round trips. The debounced
// listener on the catalog also filters on an include list that names none of
// them, so there are two independent reasons this markup cannot fetch.
//
// Visibility is driven by data-style-display and NOT by data-show. data-show
// REMOVES the display property when its expression is truthy, which on a flex
// container leaves the element at display:block; and both attributes install a
// MutationObserver on the style attribute, so using them together on one element
// is two writers fighting over one property. The inline display:none is the state
// before the script runs.
//
// FR-055: every manifest-derived string below — a path, a note, a name, a schema
// path — is interpolated by templ and therefore escaped. Nothing in this file
// calls templ.Raw, and internal/archcheck fails the build if it ever does.

templ ImportModal(im Import) {
	<!-- Hidden before the script runs: a full-viewport overlay that painted
		     visible would swallow every click on the catalog underneath it. -->
	<div
		class="am-import-backdrop"
		style="display:none;position:fixed;inset:0;z-index:40;background:rgba(15,18,22,0.42);align-items:flex-start;justify-content:center;padding:64px 24px;overflow:auto"
		data-style-display="$_importOpen ? 'flex' : 'none'"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-label="Register a package"
			style="width:100%;max-width:580px;border:1px solid var(--bd);border-radius:14px;background:var(--surface);overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.28)"
		>
			<div style="padding:20px 24px;border-bottom:1px solid var(--bd);display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
				<div style="display:flex;flex-direction:column;gap:5px">
					<div style="font-size:17px;font-weight:500">Register a package</div>
					<div style="font-size:12.5px;color:var(--fg2)">
						A plugin or skill is a directory, not one file. Upload the whole tree as an
						archive, or point the hub at a repository.
					</div>
				</div>
				<button
					type="button"
					aria-label="Close"
					style="border:0;background:none;font-size:16px;color:var(--fg3);cursor:pointer;line-height:1"
					data-on:click="$_importOpen = false"
				>×</button>
			</div>

			<div style="padding:16px 24px 0;display:flex;gap:6px" role="tablist">
				for _, tab := range view.ImportTabs {
					<button
						type="button"
						role="tab"
						class="am-chip"
						data-class={ ImportTabClassExpr(tab.ID) }
						data-attr:aria-selected={ ImportTabSelectedExpr(tab.ID) }
						data-on:click={ ImportTabExpr(tab.ID) }
					>{ tab.Label }</button>
				}
			</div>

			<div style="display:none;padding:18px 24px 0;flex-direction:column;gap:14px" data-style-display="$_importTab === 'upload' ? 'flex' : 'none'">
				<label style="border:1px dashed var(--bd);border-radius:11px;background:var(--surface2);padding:28px 20px;display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer">
					<span style="font-size:13.5px;font-weight:500" data-text="$_importFile || 'Drop a .zip or .tar.gz archive'">
						Drop a .zip or .tar.gz archive
					</span>
					<span style="font-size:12.5px;color:var(--fg3);text-align:center">
						plugin.json at the archive root, with skills/, mcp.json and any client
						namespaces alongside it. Up to 25 MB.
					</span>
					<input
						type="file"
						name="archive"
						accept=".zip,.tar.gz,.tgz"
						style="display:none"
						data-on:change="$_importFile = el.files.length ? el.files[0].name : ''"
					/>
				</label>
				if im.Preview != nil {
					@importPreview(*im.Preview)
				}
			</div>

			<div style="display:none;padding:18px 24px 0;flex-direction:column;gap:14px" data-style-display="$_importTab === 'url' ? 'flex' : 'none'">
				<div style="display:flex;flex-direction:column;gap:6px">
					<label for="import-url" style="font-size:12px;color:var(--fg3)">Repository or archive URL</label>
					<input
						id="import-url"
						class="am-search"
						style="font-family:'IBM Plex Mono',monospace;font-size:12px;background:var(--surface2)"
						placeholder="https://github.com/org/plugin or https://.../plugin-1.3.0.zip"
						data-bind="_importURL"
					/>
				</div>
				<div style="display:flex;gap:12px;flex-wrap:wrap">
					<div style="flex:1;min-width:160px;display:flex;flex-direction:column;gap:6px">
						<label for="import-ref" style="font-size:12px;color:var(--fg3)">Ref</label>
						<input
							id="import-ref"
							class="am-search"
							style="font-family:'IBM Plex Mono',monospace;font-size:12px;background:var(--surface2)"
							placeholder="v1.3.0"
							data-bind="_importRef"
						/>
					</div>
					<div style="flex:1;min-width:160px;display:flex;flex-direction:column;gap:6px">
						<label for="import-subdir" style="font-size:12px;color:var(--fg3)">Subdirectory</label>
						<input
							id="import-subdir"
							class="am-search"
							style="font-family:'IBM Plex Mono',monospace;font-size:12px;background:var(--surface2)"
							placeholder="plugins/platform-toolkit"
							data-bind="_importSubdir"
						/>
					</div>
				</div>
			</div>

			<div style="padding:18px 24px 0;display:flex;gap:12px;flex-wrap:wrap">
				<div style="flex:1;min-width:160px;display:flex;flex-direction:column;gap:6px">
					<!--
						The publisher is a form field and not a derivation. No source carries
						one — a repository has an owner, an archive URL has a host, and neither
						is a namespace this hub chose — and the object key it becomes is
						permanent, so it is asked for rather than guessed.
					-->
					<label for="import-publisher" style="font-size:12px;color:var(--fg3)">Publisher</label>
					<input
						id="import-publisher"
						class="am-search"
						style="font-family:'IBM Plex Mono',monospace;font-size:12px;background:var(--surface2)"
						placeholder="example"
						data-bind="_importPublisher"
					/>
				</div>
				<div style="flex:1;min-width:160px;display:flex;flex-direction:column;gap:6px">
					<label for="import-category" style="font-size:12px;color:var(--fg3)">Category</label>
					<select id="import-category" name="category" class="am-search" style="background:var(--surface2);font-size:12.5px">
						for _, name := range im.Categories {
							<option value={ name }>{ name }</option>
						}
					</select>
				</div>
				<div style="flex:1;min-width:160px;display:flex;flex-direction:column;gap:6px">
					<label for="import-visibility" style="font-size:12px;color:var(--fg3)">Visibility</label>
					<select id="import-visibility" name="visibility" class="am-search" style="background:var(--surface2);font-size:12.5px">
						for _, option := range view.ImportVisibilities {
							<option value={ option.Value }>{ option.Label }</option>
						}
					</select>
				</div>
			</div>

			<div style="margin:18px 24px 0;padding:14px 16px;border:1px solid var(--bd);border-radius:10px;background:var(--surface2);font-size:12.5px;color:var(--fg2);line-height:1.6">
				The hub unpacks the tree, validates plugin.json against the Agent Plugins schema it
				names, derives the components from the files rather than the manifest, then writes
				the tree as an immutable version in object storage and queues the scan. Files
				outside the spec layout are dropped, and listed above before anything is stored.
			</div>

			<div style="padding:18px 24px 22px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
				<div style="font-size:12px;color:var(--fg3)">Scanner verdict usually lands in under a minute</div>
				<div style="display:flex;gap:10px">
					<button type="button" class="am-btn" data-on:click="$_importOpen = false">Cancel</button>
					<button type="submit" class="am-btn am-btn-primary">Validate and scan</button>
				</div>
			</div>
		</div>
	</div>
}

// importPreview is FR-005's panel: every entry with a mark, and the dropped paths
// named, before the user commits to registering.
templ importPreview(p view.ImportPreview) {
	<div style="border:1px solid var(--bd);border-radius:11px;overflow:hidden">
		<div style="padding:12px 16px;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;gap:12px">
			<div style="font-size:12.5px;font-weight:500">Archive contents</div>
			if p.Name != "" {
				<div class="am-id">{ p.Name } { p.Version }</div>
			}
		</div>
		for _, entry := range p.Entries {
			<div style="padding:10px 16px;border-bottom:1px solid var(--bd);display:flex;align-items:center;gap:10px">
				<span style={ ImportMarkStyle(entry) }>{ entry.Glyph() }</span>
				<span class="am-cell-mono" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{ entry.Path }</span>
				<span style="flex:0 0 auto;font-size:11.5px;color:var(--fg3)">{ entry.Note }</span>
			</div>
		}
		for _, problem := range p.Problems {
			<div style="padding:10px 16px;border-bottom:1px solid var(--bd);display:flex;flex-direction:column;gap:3px;background:var(--surface2)">
				<span class="am-cell-mono" style="color:var(--dan)">{ problem.Where() }</span>
				<span style="font-size:11.5px;color:var(--fg2)">{ problem.Message }</span>
			</div>
		}
	</div>
}
