package components

import (
	"strconv"

	"agent-manager/internal/web/view"
)

// PackageScreen is the detail page of US3.
//
// The plugin and the skill variants differ STRUCTURALLY and not by an empty
// panel: a standalone skill has no package-contents section at all (US3
// scenario 2), because a skill has no components and a section headed "Package
// contents" over an empty tree says something false about the package rather
// than nothing about it.
//
// One control the design draws is deliberately absent: "View source" has no
// target — `version` records where bytes were STORED and nothing about where
// they came from, so the button is unimplementable for a URL registration and
// meaningless for an uploaded archive. A control with nothing behind it is
// worse than a screen without it.
templ PackageScreen(p view.Package) {
	<div class="am-detail-head">
		<a class="am-back" href="/catalog">← Catalog</a>
		if p.SignedOut || p.Missing {
			<h1 class="am-h1">Package</h1>
		} else {
			<h1 class="am-h1">{ p.Name }</h1>
			<div class="am-detail-ids">
				<span class="am-mono am-id">{ p.ID }</span>
				<span class="am-detail-sep">|</span>
				<span class="am-detail-pub">{ p.Publisher }</span>
				if p.Verified {
					<span class="am-verified">Verified publisher</span>
				}
				<span class={ KindClass(p.Kind) }>{ p.Kind.Label() }</span>
				<span class={ ScanClass(p.Scan) }>{ p.Scan.Label() }</span>
				<span class={ VisibilityClass(p.Visibility) }>{ p.VisibilityLabel() }</span>
				if p.Category != "" {
					<span class="am-detail-cat">{ p.Category }</span>
				}
			</div>
			if p.Notice != nil {
				<div class={ NoticeClass(*p.Notice) } id="package-notice">{ p.Notice.Text }</div>
			}
			@visibilityControl(p)
			@addToProfile(p)
			@packageDeleteControl(p)
		}
	</div>
	if p.Notice != nil {
		<div class={ NoticeClass(*p.Notice) } id="package-notice">{ p.Notice.Text }</div>
	}
	if p.SignedOut {
		<div class="am-empty am-empty-auth" id="package-signed-out">
			Sign in to inspect this package. The hub has no anonymous view.
		</div>
	} else if p.Missing {
		<div class="am-empty" id="package-missing">
			No such package, or it is not readable by your identity.
		</div>
	} else {
		@packageBody(p)
	}
}

templ packageBody(p view.Package) {
	<div class="am-detail">
		<div class="am-detail-main">
			@packageDescription(p)
			if p.HasContents() {
				@packageContents(p)
			}
			@packageManifest(p)
			@CapabilityPanel(p.Capabilities)
			@PackageScanPanel(p.ScanDetail)
			@FilesPanel(p)
		</div>
		<div class="am-detail-side">
			@VersionsPanel(p)
			@DependentsPanel(p)
		</div>
	</div>
	if p.SelectedFile != nil || p.FileMissing || p.FileTooLarge || p.FileNotRenderable {
		@filesDetailPanel(p)
	}
}

// visibilityControl is FR-126's shape for a package's owner or a catalog
// admin, and everyone else: shown, disabled, with the reason stated rather
// than the control disappearing for the vast majority of viewers who may
// only read this screen, not change it.
templ visibilityControl(p view.Package) {
	<div class="am-vis-control" id="package-visibility">
		if !p.CanChangeVisibility {
			<button type="button" class="am-btn" disabled aria-disabled="true" title={ view.VisibilityChangeDisabledReason }>Change visibility</button>
			<span class="am-toggle-note">{ view.VisibilityChangeDisabledReason }</span>
		} else {
			<form method="post" action="/packages/visibility" class="am-vis-form">
				<input type="hidden" name="id" value={ p.ID }/>
				<select name="visibility" class="am-select">
					for _, option := range p.VisibilityOptions() {
						if option.Value == p.Visibility && option.Disabled {
							<option value={ option.Value } selected disabled title={ option.Reason }>{ option.Label }</option>
						} else if option.Value == p.Visibility {
							<option value={ option.Value } selected>{ option.Label }</option>
						} else if option.Disabled {
							<option value={ option.Value } disabled title={ option.Reason }>{ option.Label }</option>
						} else {
							<option value={ option.Value }>{ option.Label }</option>
						}
					}
				</select>
				<button type="submit" class="am-btn">Save</button>
			</form>
			for _, option := range p.VisibilityOptions() {
				if option.Disabled {
					<span class="am-toggle-note">{ option.Label }: { option.Reason }</span>
				}
			}
		}
	</div>
}

// addToProfile is US5's own words: "add to the profile", personal or
// organisation, beside the package's identity rather than the bottom of the
// page. Grouped by visibility (view.ProfileVisibilities) so a viewer can
// tell a private profile from an organisation-wide one at a glance.
templ addToProfile(p view.Package) {
	<div class="am-add-to-profile" id="add-to-profile">
		<div class="am-label">Add to profile</div>
		if p.ProfilesUnavailable {
			<p class="am-desc am-desc-none">Your profiles could not be read, so nothing can be added here.</p>
		} else if len(p.ProfileOptions) == 0 {
			<p class="am-desc am-desc-none">
				You have no profiles yet. <a href="/profiles">Create one</a> to add this package to it.
			</p>
		} else {
			for _, group := range view.ProfileVisibilities {
				if options := p.ProfileOptionsFor(group.Value); len(options) > 0 {
					<div class="am-add-group">
						<div class="am-add-group-label">{ group.Label }</div>
						for _, option := range options {
							@addToProfileRow(p, option)
						}
					</div>
				}
			}
		}
	</div>
}

// addToProfileRow follows org.templ's pattern for a control a role may not
// use: shown, disabled, with a tooltip AND a visible sentence naming why —
// never hidden. A profile already holding the package gets neither the
// button nor the reason — it is told instead, which is the other honest
// answer a select offering it as new would not give.
templ addToProfileRow(p view.Package, option view.ProfileOption) {
	<div class="am-add-row">
		<div class="am-dep">
			<a class="am-dep-name" href={ option.Href() }>{ option.Name }</a>
			if option.Held {
				<span class="am-dep-pin">Already in this profile</span>
			} else if !option.CanCurate {
				<button type="button" class="am-btn" disabled aria-disabled="true" title={ view.CurateDisabledReason }>Add</button>
			} else {
				<form method="post" action="/profiles/entries/add">
					<input type="hidden" name="slug" value={ option.Slug }/>
					<input type="hidden" name="id" value={ p.ID }/>
					<button type="submit" class="am-btn">Add</button>
				</form>
			}
		</div>
		if !option.Held && !option.CanCurate {
			<span class="am-toggle-note">{ view.CurateDisabledReason }</span>
		}
	</div>
}

// packageDeleteControl is catalog delete's package-level action: a whole
// package archives every one of its versions. The control is never hidden —
// a viewer without the role sees it disabled with the reason, the same
// precedent addToProfileRow and org.templ's own gated controls follow — and
// it never fires from a bare click: typing the package id is what enables
// the submit, following addEntryControl's toggle-then-reveal shape.
templ packageDeleteControl(p view.Package) {
	<div class="am-panel-toggle-row" data-signals="{_deletePkgOpen: false, _deletePkgConfirm: ''}">
		if p.DeleteAccess.Allowed {
			<button type="button" class="am-btn" data-on:click="$_deletePkgOpen = !$_deletePkgOpen">Delete package</button>
		} else {
			<button type="button" class="am-btn" disabled aria-disabled="true" title={ p.DeleteAccess.Reason }>
				Delete package
			</button>
		}
	</div>
	if !p.DeleteAccess.Allowed {
		<div class="am-toggle-note">{ p.DeleteAccess.Reason }</div>
	} else {
		<form
			method="post"
			action={ view.PackageDeleteHref(p.ID) }
			class="am-field-row"
			style="display:none"
			data-style:display="$_deletePkgOpen ? 'flex' : 'none'"
		>
			<div class="am-field">
				<label class="am-field-label" for="delete-pkg-confirm">
					Type { p.ID } to confirm. Every version archives; an existing profile
					pin or a published revision still resolves it.
				</label>
				<input id="delete-pkg-confirm" class="am-input" type="text" data-bind="_deletePkgConfirm" autocomplete="off"/>
			</div>
			<button
				type="submit"
				class="am-btn am-form-submit"
				data-attr:disabled={ PackageDeleteConfirmDisabledExpr(p.ID) }
			>Delete package</button>
		</form>
	}
}

templ packageDescription(p view.Package) {
	<section class="am-section">
		<div class="am-label">Description</div>
		if p.Description != "" {
			<p class="am-desc">{ p.Description }</p>
		} else {
			<p class="am-desc am-desc-none">The manifest carries no description.</p>
		}
		<div class="am-origin">{ p.Origin() }</div>
		if len(p.Tags) > 0 {
			<div class="am-tagrow">
				for _, tag := range p.Tags {
					<span class="am-tag">{ tag }</span>
				}
			</div>
		}
	</section>
}

// packageContents is the plugin variant's tree and component list (FR-017).
// Both are derived from the component rows: no manifest field enumerates
// components, and the bundle's file list is not stored anywhere (view.Tree).
templ packageContents(p view.Package) {
	<section class="am-section am-section-flush">
		<div class="am-section-head">
			<div class="am-section-title">Package contents</div>
			<div class="am-section-note">
				{ strconv.Itoa(p.CountOf("skill")) } skills · { strconv.Itoa(p.CountOf("mcp")) } MCP · { strconv.Itoa(p.CountOf("ext")) } extensions
			</div>
		</div>
		<pre class="am-pre">{ p.Tree() }</pre>
		for _, component := range p.Components {
			<div class="am-comp">
				<span class={ ComponentClass(component.Kind) }>{ component.Kind }</span>
				<span class="am-mono am-comp-name">{ component.Name }</span>
				<span class="am-comp-note">{ component.Note }</span>
			</div>
		}
	</section>
}

templ packageManifest(p view.Package) {
	<section class="am-section am-section-flush">
		<div class="am-section-head">
			<div class="am-section-title">{ p.ManifestPanelTitle() }</div>
			<div class="am-section-note">as stored, immutable</div>
		</div>
		<pre class="am-pre">{ p.ManifestText() }</pre>
	</section>
}

// CapabilityPanel is T060: inferred against expected, presented so that neither
// can be mistaken for a permission this hub grants.
//
// The "not scanned yet" state is a real, reachable state and not an error: the
// scanner writes both sources in the transaction that records the scan, so a
// version registered a moment ago has rows of neither. Rendering it as an empty
// comparison would say "this package reaches nothing", which is the opposite of
// what is known about it.
templ CapabilityPanel(caps view.Capabilities) {
	<section class="am-section" id="capability-panel">
		<div class="am-label">Capabilities</div>
		<p class="am-note">
			Inferred by the scanner from static analysis of the bundle. Neither package specification
			defines a permissions model, so nothing here is granted, denied or enforced — the inferred
			column is what the bytes do, and the expected column is what the publisher said they would.
		</p>
		if !caps.Scanned {
			<div class="am-empty" id="capability-unscanned">
				This version has not been scanned yet, so no capabilities have been recorded from
				either source. That is not the same as a package that reaches nothing.
			</div>
		} else if len(caps.Rows) == 0 {
			<div class="am-empty" id="capability-none">
				The scan found no network, filesystem or shell capability in this version.
			</div>
		} else {
			<div class="am-cap-head">
				<div>Capability</div>
				<div>Inferred</div>
				<div>Expected</div>
			</div>
			for _, row := range caps.Rows {
				<div class="am-cap">
					<div class="am-cap-name">
						<div class="am-mono">{ row.Name }</div>
						<div class={ StatusClass(row) }>{ row.Status() }</div>
					</div>
					@capabilityFacet(row.Inferred)
					@capabilityFacet(row.Expected)
				</div>
			}
		}
	</section>
}

templ capabilityFacet(facet view.CapabilityFacet) {
	<div class="am-cap-side">
		if facet.Present {
			<span class={ LevelClass(facet.Level) }>{ view.LevelLabel(facet.Level) }</span>
			if facet.Targets() != "" {
				<div class="am-cap-targets">{ facet.Targets() }</div>
			}
		} else {
			<span class="am-cap-absent">—</span>
		}
	</div>
}

// VersionsPanel is FR-019: semver, dist tag, date, the FULL object key and the
// sha256. The key is shown whole rather than abbreviated because the point of
// showing it is that an operator can find the bytes in the bucket.
templ VersionsPanel(p view.Package) {
	<section
		class="am-section am-section-flush"
		id="versions-panel"
		data-signals="{_deleteVersion: '', _deleteVersionConfirm: ''}"
	>
		<div class="am-section-head">
			<div class="am-section-title">Versions</div>
			<div class="am-section-note">immutable</div>
		</div>
		for _, version := range p.Versions {
			<div class="am-ver">
				<div class="am-ver-head">
					<div class="am-ver-tags">
						<span class="am-mono am-ver-semver">{ version.Version }</span>
						if version.Tag() != "" {
							<span class={ VersionTagClass(version.Tag()) }>{ version.Tag() }</span>
						}
						if version.PinLabel() != "" {
							<span class="am-vtag am-vtag-pin">{ version.PinLabel() }</span>
						}
						<span class={ ScanClass(version.Scan) }>{ version.Scan.Label() }</span>
					</div>
					<span class="am-ver-date">{ version.Date }</span>
				</div>
				<div class="am-mono am-ver-key">{ version.ObjectKey }</div>
				if version.Digest != "" {
					<div class="am-mono am-ver-digest">{ version.Digest }</div>
				} else {
					<div class="am-ver-digest am-ver-nodigest">digest pending: the bytes have not been fetched yet</div>
				}
				if version.Size != "" {
					<div class="am-ver-size">{ version.Size }</div>
				}
				@versionDeleteControl(p, version)
			</div>
		}
	</section>
}

// versionDeleteControl is catalog delete's per-version action: the same
// disabled-with-reason and typed-confirmation shape as packageDeleteControl,
// scoped to one row. $_deleteVersion holds at most one open semver, the
// single-open idiom the catalog's own facet menu ($menu) already uses, so
// confirming one row can never leak into another's form.
templ versionDeleteControl(p view.Package, version view.PackageVersion) {
	<div class="am-panel-toggle-row">
		if p.DeleteAccess.Allowed {
			<button type="button" class="am-btn" data-on:click={ VersionDeleteToggleExpr(version.Version) }>
				Delete version
			</button>
		} else {
			<button type="button" class="am-btn" disabled aria-disabled="true" title={ p.DeleteAccess.Reason }>
				Delete version
			</button>
		}
	</div>
	if !p.DeleteAccess.Allowed {
		<div class="am-toggle-note">{ p.DeleteAccess.Reason }</div>
	} else {
		<form
			method="post"
			action={ view.VersionDeleteHref(p.ID, version.Version) }
			class="am-field-row"
			style="display:none"
			data-style:display={ VersionDeleteFormStyleExpr(version.Version) }
		>
			<div class="am-field">
				<label class="am-field-label" for={ "delete-version-confirm-" + version.Version }>
					Type { p.ID + "@" + version.Version } to confirm. An existing profile pin or a
					published revision still resolves it; this only stops it being offered for a
					new install.
				</label>
				<input
					id={ "delete-version-confirm-" + version.Version }
					class="am-input"
					type="text"
					data-bind="_deleteVersionConfirm"
					autocomplete="off"
				/>
			</div>
			<button
				type="submit"
				class="am-btn am-form-submit"
				data-attr:disabled={ VersionDeleteConfirmDisabledExpr(p.ID, version.Version) }
			>Delete version</button>
		</form>
	}
}

// DependentsPanel is US3 scenario 5, scoped to the caller.
//
// It lists exactly the profiles this identity may read (FR-044) and counts what
// it lists. There is no "N people" line: a membership row can name a group,
// nothing here knows how many people are in one, and a partial head count
// presented as a head count would be worse than none.
templ DependentsPanel(p view.Package) {
	<section class="am-section" id="dependents-panel">
		<div class="am-label">Used in profiles</div>
		<div class="am-origin">{ p.DependentsLine() }</div>
		for _, dependent := range p.Dependents {
			<div class="am-dep">
				<a class="am-dep-name" href={ view.ProfileHref(dependent.Slug) }>{ dependent.Name }</a>
				<span class="am-mono am-dep-pin">{ dependent.Resolution() }</span>
			</div>
		}
	</section>
}

// FilesPanel is US3/US5: read a skill's or plugin's files — SKILL.md and
// whatever else the bundle carries — before using it. It is a plain server
// round trip with no signals, exactly like the rest of this screen: a row
// is a link that sets ?file= and the page renders on the new request, the
// same idiom the audit screen's own detail panel uses for ?entry=.
templ FilesPanel(p view.Package) {
	<section class="am-section am-section-flush" id="files-panel">
		<div class="am-section-head">
			<div class="am-section-title">Files</div>
			<div class="am-section-note">read before using it</div>
		</div>
		if p.FilesRejected {
			<div class="am-empty" id="files-rejected">
				This version was rejected, so its files are never served — the same rule
				that keeps the hub from distributing its bundle at all.
			</div>
		} else if p.FilesUnavailable {
			<div class="am-empty" id="files-unavailable">
				This version's files could not be read. That is not the same as an empty
				bundle — retry in a moment.
			</div>
		} else if len(p.Files) == 0 {
			<div class="am-empty" id="files-empty">
				This version's bundle holds no files.
			</div>
		} else {
			for _, file := range p.Files {
				if file.Path == p.SelectedFilePath {
					<a class="am-file-row am-file-row-on" href={ p.FileHref(file.Path) } aria-current="true">
						@fileRowCells(file)
					</a>
				} else {
					<a class="am-file-row" href={ p.FileHref(file.Path) }>
						@fileRowCells(file)
					</a>
				}
			}
		}
	</section>
}

templ fileRowCells(file view.FileRow) {
	<span class="am-mono am-file-path">{ file.Path }</span>
	<span class="am-file-kind">{ file.Kind }</span>
	<span class="am-file-size">{ file.SizeLabel }</span>
}

// filesDetailPanel shows one file's content, chosen by ?file= — the audit
// screen's own detail-panel idiom (internal/web/components/audit.templ),
// reused rather than reinvented.
templ filesDetailPanel(p view.Package) {
	<div class="am-audit-panel-backdrop" style="background:rgba(15,18,22,0.42)" aria-hidden="true"></div>
	<aside class="am-audit-panel" role="dialog" aria-label="File content">
		<div class="am-audit-panel-head">
			<div class="am-audit-panel-title am-mono">{ p.SelectedFilePath }</div>
			<a class="am-audit-panel-close" aria-label="Close" href={ view.PackageHref(p.ID) }>×</a>
		</div>
		<div class="am-pane-body">
			@filesDetail(p)
		</div>
	</aside>
}

templ filesDetail(p view.Package) {
	if p.FileMissing {
		<div class="am-empty" id="file-missing">
			No such file in this version. The link may be stale, or the version has
			changed since it was shared.
		</div>
	} else if p.FileTooLarge {
		<div class="am-empty" id="file-too-large">
			This file is larger than this hub renders. It is refused rather than
			shown partially, since a partial SKILL.md that looks complete is worse
			than an honest refusal.
		</div>
	} else if p.FileNotRenderable {
		<div class="am-empty" id="file-not-renderable">
			This file is binary and is not rendered.
		</div>
	} else if p.SelectedFile != nil {
		if p.SelectedFile.Kind == "markdown" {
			@MarkdownBody(p.SelectedFile.Markdown)
		} else {
			<pre class="am-file-text">{ p.SelectedFile.Text }</pre>
		}
	}
}
