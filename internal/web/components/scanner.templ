package components

import (
	"strconv"

	"agent-manager/internal/web/view"
)

// ScannerScreen is US4's triage screen: what the scanner concluded, what it
// looked at, and the one decision a reviewer can take about it.
//
// It is a plain server render with no signals. Nothing on it filters as you type
// and nothing polls; the filter chips, the pager and the two decisions are all
// ordinary links and forms, so the screen works with a round trip per action and
// there is no datastar state to keep in step with the pane.
//
// Every string that came out of a package — the finding's title, the rule's prose,
// an evidence path, an evidence quote — is interpolated and therefore escaped.
// That is not a convention here: internal/archcheck fails the build if anything
// under internal/web calls templ.Raw at all (001 FR-055, FR-127).
templ ScannerScreen(s view.Scanner) {
	<div class="am-header">
		<div class="am-header-text">
			<h1 class="am-h1">Scanner</h1>
			<p class="am-lede">
				Every fetched version is statically analysed before it can be published. Flagged
				versions stay quarantined until a reviewer decides or the publisher ships a fix.
			</p>
		</div>
	</div>
	if s.Notice != nil {
		<div class={ NoticeClass(*s.Notice) } id="scanner-notice">{ s.Notice.Text }</div>
	}
	if s.SignedOut {
		// FR-122's three states, and the whole risk is a reader — or a test — reading
		// one as another. Distinct copy AND a distinct id for each.
		<div class="am-empty am-empty-auth" id="scanner-signed-out">
			Sign in to review scanner findings. The hub has no anonymous view.
		</div>
	} else if s.Refused {
		<div class="am-empty am-empty-auth" id="scanner-refused">
			Your role may not read scanner findings. This is not an empty scanner: there are
			findings in this hub, and a role is what decides whether you see them. Ask whoever
			administers this hub for the scanner reviewer role.
		</div>
	} else if s.Unavailable {
		<div class="am-notice am-notice-dan" id="scanner-unavailable">
			<p class="am-note">
				The hub's api did not answer, so this screen cannot show what it does not know.
				Nothing here is a statement about the scanner: findings, verdicts and overrides are
				all unread. Retry in a moment; if it persists, the api is the thing to look at.
			</p>
		</div>
	} else {
		@scannerSummary(s.Summary)
		<div class="am-gov">
			@findingsList(s)
			@findingPane(s)
		</div>
	}
}

// scannerSummary is the four headline figures. Each is computed from stored data
// by the api and formatted here; none of them is a constant in the product
// (FR-121), including the window the first two are measured over.
templ scannerSummary(summary view.ScannerSummary) {
	<div class="am-stats" id="scanner-summary">
		for _, card := range summary.Cards() {
			<div class="am-stat">
				<div class="am-stat-label">{ card.Label }</div>
				<div class={ StatValueClass(card) }>{ card.Value }</div>
				<div class="am-stat-note">{ card.Note }</div>
			</div>
		}
	</div>
}

templ findingsList(s view.Scanner) {
	<section class="am-gov-card">
		<div class="am-section-head">
			<div class="am-section-title">Findings</div>
			<div class="am-section-note">{ s.Count() }</div>
		</div>
		<div class="am-find-filters">
			for _, state := range view.FindingFilters {
				if state == s.Query.State {
					<a class="am-chip am-chip-on" href={ s.Query.FilterHref(state) } aria-current="page">
						{ view.FindingFilterLabel(state) }
					</a>
				} else {
					<a class="am-chip" href={ s.Query.FilterHref(state) }>
						{ view.FindingFilterLabel(state) }
					</a>
				}
			}
		</div>
		for _, row := range s.Findings {
			if s.Selected != nil && s.Selected.ID == row.ID {
				<a class="am-find am-find-on" href={ s.Query.SelectHref(row.ID) } aria-current="true">
					@findingRow(row)
				</a>
			} else {
				<a class="am-find" href={ s.Query.SelectHref(row.ID) }>
					@findingRow(row)
				</a>
			}
		}
		if s.Empty() {
			if s.Filtered() {
				<div class="am-empty" id="scanner-no-match">
					No findings match this filter. Others may: choose All above to see every finding
					this hub has raised, whatever a reviewer has decided about it.
				</div>
			} else {
				// FR-122: name what would appear here, and how to bring it about.
				<div class="am-empty" id="scanner-empty">
					No findings. A finding appears here when the scanner reads a version and a rule
					trips: register a package from the catalog, or publish a new version of one, and
					its scan will land under the current rule pack within about a minute.
				</div>
			}
		}
		if s.Pages() > 1 {
			<div class="am-pager">
				<span>Page { strconv.Itoa(s.CurrentPage()) } of { strconv.Itoa(s.Pages()) }</span>
				if s.CurrentPage() > 1 {
					<a class="am-pager-link" href={ s.Query.PageHref(s.CurrentPage() - 1) }>Previous</a>
				} else {
					<span class="am-pager-link am-pager-off">Previous</span>
				}
				if s.CurrentPage() < s.Pages() {
					<a class="am-pager-link" href={ s.Query.PageHref(s.CurrentPage() + 1) }>Next</a>
				} else {
					<span class="am-pager-link am-pager-off">Next</span>
				}
			</div>
		}
	</section>
}

templ findingRow(row view.FindingRow) {
	<div class="am-find-head">
		<span class="am-find-title">{ row.Title }</span>
		<span class={ SeverityClass(row.Severity) }>{ row.Severity.Label() }</span>
	</div>
	<div class="am-mono am-find-subject">{ row.Subject }</div>
	<div class="am-find-meta">
		<span class={ FindingStateClass(row.State) }>{ row.State.Label() }</span>
		<span class="am-mono am-find-rule">{ row.RuleID }</span>
		<span class="am-find-raised">{ row.Raised }</span>
	</div>
}

templ findingPane(s view.Scanner) {
	<section class="am-gov-card am-pane">
		if s.Missing {
			<div class="am-empty" id="scanner-missing">
				No such finding, or it is not readable by your identity. It may have been raised
				against a package you cannot see. Choose one from the list beside this pane.
			</div>
		} else if s.Selected == nil {
			<div class="am-empty" id="scanner-unselected">
				Choose a finding to read the rule it tripped, the evidence the scanner quoted and
				every check that ran against the version.
			</div>
		} else {
			@findingDetail(s, *s.Selected)
		}
	</section>
}

templ findingDetail(s view.Scanner, detail view.FindingDetail) {
	<div class="am-pane-head">
		<div class="am-pane-pills">
			<span class={ SeverityClass(detail.Severity) }>{ detail.Severity.Label() }</span>
			<span class="am-mono am-pane-rule">{ detail.RuleID }</span>
			<span class={ FindingStateClass(detail.State) }>{ detail.State.Label() }</span>
		</div>
		<div class="am-pane-title">{ detail.Title }</div>
		<div class="am-pane-subject">
			<a class="am-mono am-pane-link" href={ view.PackageHref(detail.PackageID) }>{ detail.Subject }</a>
			// The version's verdict, beside the finding's state and never merged with it.
			// An accept records an exception and leaves the version flagged; one pill for
			// both would tell a reader the package had become clean.
			<span class={ VerdictClass(detail.Verdict) }>{ detail.Verdict.Label() }</span>
		</div>
		<div class="am-pane-raised">Raised { detail.Raised }</div>
	</div>
	<div class="am-pane-body">
		if detail.Explanation != "" {
			<p class="am-desc">{ detail.Explanation }</p>
		} else {
			<p class="am-desc am-desc-none">The rule pack recorded no detail for this finding.</p>
		}
		@evidencePanel(detail)
		@checkMatrix(detail)
		@scanPanel(detail.Scan)
		if detail.Override != nil {
			@overridePanel(*detail.Override)
		}
	</div>
	@reviewFooter(s, detail)
}

// evidencePanel quotes bytes out of somebody else's package. Every path, line and
// quote here is interpolated, so templ escapes it; a <pre> is a text context, not
// a safe one, and markup in a quote would otherwise render as markup.
templ evidencePanel(detail view.FindingDetail) {
	<div class="am-pane-block">
		<div class="am-label">Evidence</div>
		if detail.Primary != nil {
			<div class="am-ev" id="finding-evidence">
				<div class="am-mono am-ev-loc">{ detail.Primary.Location() }</div>
				if detail.Primary.Quote != "" {
					<pre class="am-ev-quote">{ detail.Primary.Quote }</pre>
				}
			</div>
			for _, item := range detail.Supporting {
				<div class="am-ev am-ev-supporting">
					<div class="am-mono am-ev-loc">{ item.Location() }</div>
					if item.Quote != "" {
						<pre class="am-ev-quote">{ item.Quote }</pre>
					}
				</div>
			}
		} else {
			// A real and reachable state, not a rendering fault: a finding carries its
			// locations only when the scan that raised it recorded them, and the seeded
			// findings have none. Saying so beats an empty panel that reads as a bug.
			<div class="am-empty" id="finding-no-evidence">
				This finding records no file location. The rule matched the version as a whole, or
				the scan that raised it predates location capture. The detail above is what the
				rule reported.
			</div>
		}
	</div>
}

// checkMatrix is 001 FR-025, and it renders the WHOLE matrix.
//
// Every check the scanner runs writes a row on every scan, passes included, so
// this list has no holes. Filtering it to the failures would produce a pane that
// cannot be told apart from one where nothing else ran, which is the distinction
// the requirement exists for.
templ checkMatrix(detail view.FindingDetail) {
	<div class="am-pane-block">
		<div class="am-label">Checks run</div>
		if len(detail.Checks) > 0 {
			<p class="am-note">
				Every check this scan ran, passes included, so a check that did not run is
				distinguishable from one that found nothing.
			</p>
			<div id="finding-checks">
				for _, check := range detail.Checks {
					<div class="am-chk">
						<span class={ CheckMarkClass(check) } aria-hidden="true">{ check.Result.Mark() }</span>
						<span class="am-chk-label">
							{ check.Label }
							if check.Note() != "" {
								// The warn count is a blind-spot counter — files the check could
								// not read — and NOT a number of issues. Rendering it as "2" beside
								// a warning would read as two problems, which is its opposite.
								<span class="am-chk-note">{ check.Note() }</span>
							}
						</span>
						<span class="am-mono am-chk-result">{ check.Result.Label() }</span>
					</div>
				}
			</div>
		} else {
			<div class="am-empty" id="finding-no-checks">
				This scan recorded no check results, so nothing here says which checks ran. A
				completed scan always writes one row per check; a scan with none did not finish.
			</div>
		}
	</div>
}

templ scanPanel(scan view.ScanMeta) {
	<div class="am-pane-block">
		<div class="am-label">Scan</div>
		if scan.TimedOut {
			// 001 FR-031. A scan that ran out of budget reached no judgement, and the
			// absence of further findings from it is not evidence of their absence.
			<div class="am-notice am-notice-dan" id="finding-scan-timed-out">
				<p class="am-note">
					This scan exceeded its time budget and was cut short, so it reached no verdict.
					What it had found is below; what it had not yet reached is unknown. Do not read
					the missing findings as an absence of them.
				</p>
			</div>
		}
		<div class="am-kv">
			<div class="am-kv-key">Rule pack</div>
			<div class="am-mono am-kv-val">{ scan.PackVersion }</div>
		</div>
		<div class="am-kv">
			<div class="am-kv-key">Started</div>
			<div class="am-mono am-kv-val">{ scan.Started }</div>
		</div>
		<div class="am-kv">
			<div class="am-kv-key">Finished</div>
			if scan.Finished != "" {
				<div class="am-mono am-kv-val">{ scan.Finished }</div>
			} else {
				<div class="am-kv-val am-kv-none">still running</div>
			}
		</div>
		<div class="am-kv">
			<div class="am-kv-key">Scan verdict</div>
			<div class="am-kv-val"><span class={ VerdictClass(scan.Verdict) }>{ scan.Verdict.Label() }</span></div>
		</div>
	</div>
}

templ overridePanel(override view.Override) {
	<div class="am-pane-block" id="finding-override">
		<div class="am-label">Override on record</div>
		<p class="am-note">
			A reviewer accepted this finding. The version is still flagged: an override is a
			recorded exception with a name against it, not a second verdict.
		</p>
		<div class="am-kv">
			<div class="am-kv-key">Reviewer</div>
			<div class="am-kv-val">{ override.Reviewer }</div>
		</div>
		<div class="am-kv">
			<div class="am-kv-key">Decided</div>
			<div class="am-mono am-kv-val">{ override.Decided }</div>
		</div>
		<div class="am-kv">
			<div class="am-kv-key">Expires</div>
			if override.Expires != "" {
				<div class="am-kv-val">{ override.Expires }</div>
			} else {
				<div class="am-kv-val am-kv-none">never — no expiry was stated</div>
			}
		</div>
		if override.Note != "" {
			<div class="am-kv">
				<div class="am-kv-key">Note</div>
				<div class="am-kv-val">{ override.Note }</div>
			</div>
		}
	</div>
}

// reviewFooter is T072 and FR-126: the two decisions, or the reason they are not
// on offer.
//
// A viewer whose role cannot decide gets the controls DISABLED with the reason
// beside them rather than absent, because a reviewer looking for the approve
// button needs to learn that it exists and that their role is what is in the way —
// an absent control reads as a screen that has not been built. A finding that is
// already rejected gets no controls at all, because there is nothing left to
// decide and the api answers 409 rather than doing anything.
templ reviewFooter(s view.Scanner, detail view.FindingDetail) {
	<div class="am-gate">
		if detail.TerminalNote() != "" {
			<div class="am-gate-note" id="review-terminal">{ detail.TerminalNote() }</div>
		} else if !s.Review.Allowed {
			<div class="am-gate-note" id="review-not-permitted">{ s.Review.Reason }</div>
			<div class="am-gate-actions">
				<button type="button" class="am-btn" disabled aria-disabled="true">Reject version</button>
				<button type="button" class="am-btn am-btn-primary" disabled aria-disabled="true">
					Approve with note
				</button>
			</div>
		} else {
			<form class="am-review" method="post" action={ s.Query.DecideHref(detail.ID, "accept") }>
				<input type="hidden" name="return" value={ s.Query.SelectHref(detail.ID) }/>
				<label class="am-label" for="review-note">Reviewer note</label>
				<textarea
					id="review-note"
					class="am-review-note"
					name="note"
					rows="3"
					required
					maxlength={ ReviewNoteLimit() }
					placeholder="Why this risk is acceptable, or why this version is refused."
				></textarea>
				<div class="am-review-row">
					<label class="am-review-expiry" for="review-expires">
						Expires in
						<input
							id="review-expires"
							class="am-review-days"
							type="number"
							name="expires"
							min="1"
							max="365"
							inputmode="numeric"
						/>
						days
					</label>
					<span class="am-review-hint">
						Leave the expiry blank and the override does not lapse. Approving does not
						clear the verdict: the version stays flagged with this note against it.
					</span>
				</div>
				<div class="am-gate-actions">
					// formnovalidate is what lets one note field serve both decisions: the api
					// requires a note to approve and does not to reject, and the browser's own
					// required-field check would otherwise impose the stricter rule on both.
					<button
						type="submit"
						class="am-btn"
						formaction={ s.Query.DecideHref(detail.ID, "reject") }
						formnovalidate
					>
						Reject version
					</button>
					<button type="submit" class="am-btn am-btn-primary">Approve with note</button>
				</div>
			</form>
		}
	</div>
}
