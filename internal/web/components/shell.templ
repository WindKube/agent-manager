package components

import "agent-manager/internal/web/view"

templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang="en" data-sm-theme={ s.Theme }>
		@head(s)
		<body>
			<div class="am-page">
				@sidebar(s)
				<main class="am-main">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

// head is shared with the sign-in page so theme, asset URLs and title cannot drift.
templ head(s Shell) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ s.Title } · { ProductName }</title>
		<link rel="stylesheet" href={ s.AppCSS }/>
		<script type="module" src={ s.VendorJS }></script>
		<script src={ s.AppJS }></script>
	</head>
}

templ sidebar(s Shell) {
	<aside class="am-sidebar">
		<div class="am-brand">
			<div class="am-brand-row">
				<div class="am-brand-mark"></div>
				<div class="am-brand-name">{ ProductName }</div>
			</div>
			<div class="am-brand-host">hub.example.dev</div>
		</div>
		<nav class="am-nav">
			for _, group := range Nav {
				<div class="am-nav-group">
					<div class="am-nav-label">{ group.Label }</div>
					for _, item := range group.Items {
						if reason := s.Gate(item.ID); reason != "" {
							<span class="am-nav-item am-nav-item-gated" aria-disabled="true" title={ reason }>
								@navLabel(s, item)
							</span>
						} else if item.ID == s.Active {
							<a class="am-nav-item" href={ item.Href } aria-current="page">
								@navLabel(s, item)
							</a>
						} else {
							<a class="am-nav-item" href={ item.Href }>
								@navLabel(s, item)
							</a>
						}
					}
				</div>
			}
		</nav>
		<div class="am-viewer">
			if s.Viewer != nil {
				@viewerChip(*s.Viewer)
			} else {
				// No chip at all when signed out, not a placeholder. The spacer does
				// the chip's flex:1 so the toggle stays put.
				<div class="am-spacer"></div>
			}
			@themeToggle(s)
			if s.Viewer != nil {
				@signOut()
			}
		</div>
	</aside>
}

// viewerChip renders the resolved viewer only; nothing here has a default.
templ viewerChip(v view.Viewer) {
	<div class="am-avatar">{ v.Initials() }</div>
	<div class="am-viewer-id">
		<div class="am-viewer-name">{ v.DisplayName }</div>
		if v.HasRole {
			<div class="am-viewer-role">{ v.RoleLabel() }</div>
		} else {
			// An empty role line would read as a broken render, not the state an
			// administrator must act on. Branch on HasRole, not the label, since an
			// unfamiliar role spelling is still a role held.
			<div class="am-viewer-role">No role</div>
		}
	</div>
}

templ themeToggle(s Shell) {
	<form method="post" action="/theme">
		<input type="hidden" name="theme" value={ s.Next }/>
		<input type="hidden" name="return" value={ s.Return }/>
		<button type="submit" class="am-theme-toggle" title="Toggle theme" aria-label="Toggle theme">
			{ s.ToggleIcon() }
		</button>
	</form>
}

// signOut must stay a POST form: a GET sign-out is triggerable by any image tag.
// It needs no token because the SameSite=Lax cookie is absent on a cross-site POST,
// and no return field because it always lands on sign-in.
templ signOut() {
	<form method="post" action="/auth/logout">
		<button type="submit" class="am-signout">Sign out</button>
	</form>
}

// navLabel renders a badge only for a non-zero count; an empty badge reads as a gap.
templ navLabel(s Shell, item NavItem) {
	<span>{ item.Label }</span>
	if badge := s.Badge(item.ID); badge != "" {
		if item.Alert {
			<span class="am-nav-badge am-nav-badge-alert">{ badge }</span>
		} else {
			<span class="am-nav-badge">{ badge }</span>
		}
	}
}

// Placeholder keeps the sidebar navigable for a screen not built yet.
templ Placeholder(title, lede string) {
	<div class="am-header">
		<div class="am-header-text">
			<h1 class="am-h1">{ title }</h1>
			<p class="am-lede">{ lede }</p>
		</div>
	</div>
	<div class="am-placeholder">
		This screen is not built yet in this layer of the stack. The shell, the theme and the
		catalog's facet interaction are; the remaining screens land in the layers that own them.
	</div>
}
